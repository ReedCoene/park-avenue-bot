# Copy to ".env" and fill in. NEVER commit .env or share it.

# --- Slack (from api.slack.com/apps -> your app) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token   # Socket Mode token (no public URL needed)

# Only these Slack user IDs can pull FINANCIALS / post to QuickBooks (comma-separated, e.g. U0123,U0456 = mom + manager).
# Leave EMPTY for the demo (everyone allowed). Everyone can always use Fishbowl/inventory features.
FINANCE_USERS=

# --- Anthropic (the bot's brain; one key, server-side; employees need NOTHING) ---
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-sonnet-4-6

# --- QuickBooks Online (the COMPANY's file; use fresh creds, rotate anything ever exposed) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_REDIRECT_URI=https://httpbin.org/get

# --- Fishbowl (company server; use a read/write API user, not admin) ---
FB_SERVER=
FB_PORT=3635
FB_USERNAME=
FB_PASSWORD=

# Where the daily digest posts (a Slack channel id, e.g. C0123ABC)
DIGEST_CHANNEL=
