# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Fishbowl Inventory ───────────────────────────────────────────────────────
FB_SERVER=your-instance.myfishbowl.com
FB_PORT=3635
FB_USERNAME=admin
FB_PASSWORD=your-fishbowl-password

# ── QuickBooks Online ────────────────────────────────────────────────────────
# From an app created at developer.intuit.com (use PRODUCTION keys, not sandbox).
QBO_CLIENT_ID=your-intuit-client-id
QBO_CLIENT_SECRET=your-intuit-client-secret
QBO_REDIRECT_URI=https://httpbin.org/get
QBO_ENVIRONMENT=production
# These two are written automatically by `node reauth.js` — leave blank initially.
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
# The company ID. `reauth.js` fills this in from Intuit's company chooser.
QBO_REALM_ID=

# ── Slack ────────────────────────────────────────────────────────────────────
# Create the app from slack-app-manifest.yaml, then:
#   SLACK_BOT_TOKEN  — OAuth & Permissions > Bot User OAuth Token
#   SLACK_APP_TOKEN  — Basic Information > App-Level Tokens (scope: connections:write)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Comma-separated Slack member IDs allowed to command the bot.
# The bot refuses to start if this is empty — an open bot could move money.
SLACK_ALLOWED_USERS=U01ABC23DEF

# ── QuickBooks chart-of-accounts IDs ─────────────────────────────────────────
# Account IDs are specific to each QuickBooks company, so they are configured here
# rather than hardcoded. Find yours by running: SELECT * FROM Account
QBO_UNDEPOSITED_FUNDS_ID=46
QBO_CHECKING_ACCOUNT_ID=
QBO_CHECKING_ACCOUNT_NAME=Checking

# ── Local data files ─────────────────────────────────────────────────────────
# Optional: path to a Fishbowl inventory CSV export used by the reporting scripts.
INVENTORY_CSV_PATH=./InvQtys.csv

# ── Demo controls ────────────────────────────────────────────────────────────
# DEMO_MODE=1  simulates every payment; nothing is written to QuickBooks.
# DEMO_QUIET=1 additionally hides the "DEMO MODE" label from payment replies.
# Both MUST be 0 for real use.
DEMO_MODE=0
DEMO_QUIET=0
